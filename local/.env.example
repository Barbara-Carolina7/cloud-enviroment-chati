# Copia este archivo a local/.env y ajústalo. local/.env no se versiona.
# Las variables ya definidas en tu entorno tienen prioridad sobre este archivo.

# Base de datos para el stack local (única variable obligatoria).
# El BFF y la Lambda derivan de aquí usuario, clave, host y base.
DATABASE_URL=postgresql://USUARIO@localhost:5432/reports_local

# false para un Postgres local sin SSL; quítalo (o true) para Supabase.
DATABASE_SSL=false

# Usuario falso del servidor OIDC (opcionales).
# MOCK_EMAIL=admin@local.test
# MOCK_SUB=local-admin-sub
# MOCK_GROUPS=Admin        # Prueba el 403 con: MOCK_GROUPS=Colaborador
# MOCK_PORT=9000
