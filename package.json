{
  "name": "aws-chati-tooling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Comandos multiplataforma (Mac, Linux, Windows) para el stack local y utilidades de la base de datos",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "local:up": "node scripts/local/up.js",
